DEFCONFIG=gki_defconfig
PRE_DEFCONFIG_CMDS="merge_config_fragment"
POST_DEFCONFIG_CMDS=""
KERNEL_DIR="kernel-5.10"
ARCH=arm64
BRANCH=android17-6.18

function merge_config_fragment() {
    ${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -O ${OUT_DIR} \
        ${OUT_DIR}/.config \
        ${KERNEL_DIR}/arch/arm64/configs/vitamin_gki.fragment
}

FILES="
arch/arm64/boot/Image
arch/arm64/boot/dts/mediatek/mt6983.dtb
arch/arm64/boot/dts/mediatek/oplus6983_22823.dtbo
vmlinux
System.map
"

EXTRA_CMDS="
make -j\$(nproc) O=\${OUT_DIR} Image mediatek/mt6983.dtb mediatek/oplus6983_22823.dtbo modules
"
