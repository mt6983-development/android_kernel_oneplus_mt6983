# OnePlus Nord 3 (vitamin, MT6983) Debug Config Fragment (BOOT-FIRST RULE 4)
# Use in combination with vitamin_gki.fragment for verbose diagnostics

# Early Console & Printk Verbosity
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_PRINTK_CALLER=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y

# Boot Tracing & Initcall Diagnostics
CONFIG_BOOTTIME_TRACING=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FTRACE=y
CONFIG_PANIC_TIMEOUT=5

# Pstore / Ramoops Verbose Logging
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y

# Lockup & Stall Detectors
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# Power Management Diagnostics
# CONFIG_PM_DEBUG=y
# CONFIG_SUSPEND_SKIP_SYNC is not set
