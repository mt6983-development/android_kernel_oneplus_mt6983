# OnePlus Nord 3 (vitamin, MT6983) Vendor GKI 6.18 Config Fragment
# Milestone M0 Minimal Boot Options

# MediaTek SoC & Architecture
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_BOOT_CONFIG=y

# Clocks & Pinctrl
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_COMMON_CLK_MT6983=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MT6983=y

# Power Management & Regulators (PMIC / SPMI)
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Storage & Filesystems (UFS 3.1, F2FS, EROFS, EXT4)
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_AVB=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_ZRAM=m

# IOMMU & DMA-BUF Heaps
CONFIG_IOMMU_SUPPORT=y
CONFIG_MTK_IOMMU=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Serial & Early Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# USB & Android Gadget (ADB)
CONFIG_USB_SUPPORT=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_ACC=y

# Android IPC & Security
CONFIG_SECURITY_SELINUX=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Crash Logging & Diagnostics
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
