# OnePlus Nord 3 (vitamin, MT6983) Vendor GKI 6.18 Config Fragment
# Milestone M0 Minimal Boot Options

# MediaTek SoC & Architecture
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_BOOT_CONFIG=y

# Clocks & Pinctrl
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_COMMON_CLK_MT6983=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MT6983=y

# Power Management & Regulators (PMIC / SPMI)
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Storage & Filesystems (UFS 3.1, F2FS, EROFS, EXT4)
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_AVB=y
CONFIG_DM_VERITY_FEC=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP_LZ4=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_ZRAM=m
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_ANDROID_IOCTL=y

# IOMMU & DMA-BUF Heaps
CONFIG_IOMMU_SUPPORT=y
CONFIG_MTK_IOMMU=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Serial & Early Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# USB & Android Gadget (ADB)
CONFIG_USB_SUPPORT=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_ACC=y

# Android IPC & Security
CONFIG_SECURITY_SELINUX=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Crash Logging & Diagnostics
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Display, Backlight, Touch & Haptics (Milestone M2)
CONFIG_MTK_MMSYS=y
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_MEDIATEK_DP=m
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_LEDS_CLASS=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_FF_MEMLESS=y

# Power, DVFS, Thermal & Charging (Milestone M3)
CONFIG_CPU_FREQ=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_POWER_SUPPLY=y
CONFIG_OPLUS_CHG=m
CONFIG_OPLUS_CHG_V2=m

# GPU, Multimedia, Sensors, NFC & Fingerprint (Milestone M4)
CONFIG_VIDEO_MEDIATEK_VCODEC=m
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MTK_BTCVSD=m
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_NFC=m
CONFIG_UFF_FINGERPRINT=m
